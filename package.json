{
  "name": "obsidian-ai-assistant",
  "version": "0.3.6",
  "description": "Local AI assistant with tool calling for Obsidian (OpenAI-compatible / vLLM)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": ["obsidian", "plugin", "ai", "llm", "vllm"],
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.10",
    "openai": "^4.40.0"
  }
}
